{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pitchside:schema:world:1",
  "title": "World",
  "description": "The fictional football world: invented clubs, squads and crests. Nothing here may reference a real club, league, player or broadcaster.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "clubs"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "clubs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/Club" }
    }
  },
  "$defs": {
    "Club": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_id",
        "name",
        "short_name",
        "city",
        "colors",
        "crest",
        "formation",
        "starting_xi",
        "players"
      ],
      "properties": {
        "team_id": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "name": { "type": "string", "minLength": 1 },
        "short_name": { "type": "string", "minLength": 1 },
        "city": { "type": "string", "minLength": 1 },
        "colors": { "$ref": "#/$defs/Colors" },
        "crest": { "$ref": "#/$defs/Crest" },
        "formation": { "$ref": "#/$defs/Formation" },
        "starting_xi": {
          "description": "Player ids in formation slot order (see services/sim/formation.py).",
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "players": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": { "$ref": "#/$defs/Player" }
        }
      }
    },
    "Colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "$ref": "#/$defs/HexColor" },
        "secondary": { "$ref": "#/$defs/HexColor" }
      }
    },
    "HexColor": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
    "Crest": {
      "description": "Parameters for the generated SVG crest in data/crests/.",
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "motif"],
      "properties": {
        "shape": { "type": "string", "enum": ["shield", "circle", "hexagon", "diamond"] },
        "motif": { "type": "string", "enum": ["stripe", "chevron", "star", "wave", "ring"] }
      }
    },
    "Formation": { "type": "string", "enum": ["4-3-3", "4-4-2", "4-2-3-1", "3-5-2"] },
    "Position": {
      "type": "string",
      "enum": ["GK", "RB", "CB", "LB", "RWB", "LWB", "DM", "CM", "AM", "RM", "LM", "RW", "LW", "ST"]
    },
    "Player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_id", "name", "short_name", "shirt_number", "position", "attributes"],
      "properties": {
        "player_id": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$" },
        "name": { "type": "string", "minLength": 1 },
        "short_name": { "type": "string", "minLength": 1 },
        "shirt_number": { "type": "integer", "minimum": 1, "maximum": 99 },
        "position": { "$ref": "#/$defs/Position" },
        "attributes": { "$ref": "#/$defs/Attributes" }
      }
    },
    "Attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pace", "passing", "finishing", "pressing", "stamina"],
      "properties": {
        "pace": { "$ref": "#/$defs/Rating" },
        "passing": { "$ref": "#/$defs/Rating" },
        "finishing": { "$ref": "#/$defs/Rating" },
        "pressing": { "$ref": "#/$defs/Rating" },
        "stamina": { "$ref": "#/$defs/Rating" }
      }
    },
    "Rating": { "type": "integer", "minimum": 1, "maximum": 99 }
  }
}
