        "clock_display",
        "minute",
        "seq",
        "home",
        "away",
        "possession_team_id",
        "goals",
        "cards",
        "momentum"
      ],
      "properties": {
        "match_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MatchStatus"
        },
        "scenario": {
          "type": "string"
        },
        "period": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
