          "type": "integer"
        },
        "xg": {
          "type": [
            "number",
            "null"
          ]
        },
        "shot_speed_kmh": {
          "type": [
            "number",
            "null"
          ]
        },
        "score_after": {
          "description": "Home-away, e.g. '2-1'.",
          "type": "string"
        }
      }
    },
    "CardItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "team_id",
        "player_id",
        "player_name",
        "minute",
        "card_color"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "team_id": {
          "type": "string"
        },
        "player_id": {
          "type": "string"
        },
        "player_name": {
          "type": "string"
        },
        "minute": {
          "$ref": "#/$defs/Minute"
        },
        "card_color": {
          "type": "string",
          "enum": [
            "yellow",
            "second_yellow",
            "red"
          ]
        }
      }
