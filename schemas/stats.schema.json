{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pitchside:schema:stats:1",
  "title": "StatsSnapshot",
  "description": "Published by the Stats Engine after events that change the numbers (throttled). Feeds the scoreboard, corner stat bug, momentum ribbon and player tags. The $defs are the payloads of the Match Stats MCP tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "match_id",
    "seq",
    "status",
    "period",
    "clock_ms",
    "clock_display",
    "minute",
    "teams",
    "momentum",
    "players"
  ],
  "properties": {
    "match_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "$ref": "#/$defs/MatchStatus"
    },
    "period": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "clock_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7200000
    },
    "clock_display": {
      "$ref": "#/$defs/ClockDisplay"
    },
    "minute": {
      "$ref": "#/$defs/Minute"
    },
    "teams": {
      "description": "Home first.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/TeamStats"
      }
    },
    "momentum": {
      "$ref": "#/$defs/MomentumNow"
    },
    "players": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlayerLine"
      }
    }
  },
  "$defs": {
    "ClockDisplay": {
      "description": "Broadcast clock, e.g. '67:12' or '45+02:18' in stoppage time.",
      "type": "string",
      "pattern": "^[0-9]{2,3}:[0-9]{2}$|^(45|90)\\+[0-9]{2}:[0-9]{2}$"
    },
    "Minute": {
      "description": "Football minute, e.g. \"68'\" or \"90+3'\".",
      "type": "string",
      "pattern": "^[0-9]{1,3}'$|^(45|90)\\+[0-9]{1,2}'$"
    },
    "Window": {
      "description": "Time window for stats: the whole match, one half, or the last N minutes of playing time.",
      "type": "string",
      "enum": [
        "match",
        "first_half",
        "second_half",
        "last_5",
        "last_10",
        "last_15"
      ]
    },
    "TeamStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_id",
        "name",
        "short_name",
        "goals",
        "shots",
        "shots_on_target",
        "xg",
        "max_shot_speed_kmh",
        "passes",
        "passes_completed",
        "pass_accuracy_pct",
        "avg_pass_distance_m",
        "avg_pass_speed_kmh",
        "avg_pass_difficulty",
        "difficult_passes_completed",
        "possession_pct",
        "pressures",
        "tackles",
        "tackles_won",
        "interceptions",
        "fouls",
        "yellow_cards",
        "red_cards",
        "corners",
        "turnovers",
        "ppda",
        "distance_km",
        "sprints",
        "top_speed_kmh"
      ],
      "properties": {
        "team_id": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "name": {
          "type": "string"
        },
        "short_name": {
          "type": "string"
        },
        "goals": {
          "type": "integer",
          "minimum": 0
        },
        "shots": {
          "type": "integer",
          "minimum": 0
        },
        "shots_on_target": {
          "type": "integer",
          "minimum": 0
        },
        "xg": {
          "description": "Sum of shot xG, 2 dp.",
          "type": "number",
          "minimum": 0
        },
        "max_shot_speed_kmh": {
          "type": [
            "number",
            "null"
          ]
        },
        "passes": {
          "type": "integer",
          "minimum": 0
        },
        "passes_completed": {
          "type": "integer",
          "minimum": 0
        },
        "pass_accuracy_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "avg_pass_distance_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "avg_pass_speed_kmh": {
          "type": [
            "number",
            "null"
          ]
        },
        "avg_pass_difficulty": {
          "description": "Mean pass difficulty, 0-100.",
          "type": [
            "number",
            "null"
          ]
        },
        "difficult_passes_completed": {
          "description": "Completed passes with difficulty above 80.",
          "type": "integer",
          "minimum": 0
        },
        "possession_pct": {
          "description": "Share of ball-in-play time, 1 dp.",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "pressures": {
          "type": "integer",
          "minimum": 0
        },
        "tackles": {
          "type": "integer",
          "minimum": 0
        },
        "tackles_won": {
          "type": "integer",
          "minimum": 0
        },
        "interceptions": {
          "type": "integer",
          "minimum": 0
        },
        "fouls": {
          "type": "integer",
          "minimum": 0
        },
        "yellow_cards": {
          "type": "integer",
          "minimum": 0
        },
        "red_cards": {
          "type": "integer",
          "minimum": 0
        },
        "corners": {
          "type": "integer",
          "minimum": 0
        },
        "turnovers": {
          "description": "Possessions lost other than by shooting.",
          "type": "integer",
          "minimum": 0
        },
        "ppda": {
          "description": "Opponent passes allowed per defensive action in the opponent's first 60% of the pitch. Lower means a more intense press. Null when there were no defensive actions.",
          "type": [
            "number",
            "null"
          ]
        },
        "distance_km": {
          "type": "number",
          "minimum": 0
        },
        "sprints": {
          "type": "integer",
          "minimum": 0
        },
        "top_speed_kmh": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "PlayerStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_id",
        "name",
        "short_name",
        "team_id",
        "shirt_number",
        "position",
        "on_pitch",
        "minutes_played",
        "touches",
        "passes",
        "passes_completed",
        "pass_accuracy_pct",
        "avg_pass_difficulty",
        "max_pass_difficulty",
        "key_passes",
        "shots",
        "shots_on_target",
        "goals",
        "xg",
        "max_shot_speed_kmh",
        "pressures",
        "tackles_won",
        "interceptions",
        "fouls",
        "yellow_cards",
        "red_cards",
        "distance_km",
        "sprints",
        "top_speed_kmh"
      ],
      "properties": {
        "player_id": {
          "type": "string",
          "pattern": "^[A-Z]{3}-[0-9]{2}$"
        },
        "name": {
          "type": "string"
        },
        "short_name": {
          "type": "string"
        },
        "team_id": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "shirt_number": {
          "type": "integer"
        },
        "position": {
          "type": "string"
        },
        "on_pitch": {
          "type": "boolean"
        },
        "minutes_played": {
          "type": "integer",
          "minimum": 0
        },
        "touches": {
          "type": "integer",
          "minimum": 0
        },
        "passes": {
          "type": "integer",
          "minimum": 0
        },
        "passes_completed": {
          "type": "integer",
          "minimum": 0
        },
        "pass_accuracy_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "avg_pass_difficulty": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_pass_difficulty": {
          "type": [
            "number",
            "null"
          ]
        },
        "key_passes": {
          "description": "Completed passes after which the receiver's next action was a shot.",
          "type": "integer",
          "minimum": 0
        },
        "shots": {
          "type": "integer",
          "minimum": 0
        },
        "shots_on_target": {
          "type": "integer",
          "minimum": 0
        },
        "goals": {
          "type": "integer",
          "minimum": 0
        },
        "xg": {
          "type": "number",
          "minimum": 0
        },
        "max_shot_speed_kmh": {
          "type": [
            "number",
            "null"
          ]
        },
        "pressures": {
          "type": "integer",
          "minimum": 0
        },
        "tackles_won": {
          "type": "integer",
          "minimum": 0
        },
        "interceptions": {
          "type": "integer",
          "minimum": 0
        },
        "fouls": {
          "type": "integer",
          "minimum": 0
        },
        "yellow_cards": {
          "type": "integer",
          "minimum": 0
        },
        "red_cards": {
          "type": "integer",
          "minimum": 0
        },
        "distance_km": {
          "type": "number",
          "minimum": 0
        },
        "sprints": {
          "type": "integer",
          "minimum": 0
        },
        "top_speed_kmh": {
          "type": [
            "number",
            "null"
          ]
        },
        "heatmap": {
          "$ref": "#/$defs/Heatmap"
        }
      }
    },
    "Heatmap": {
      "description": "Share of tracked time in each zone, in the player's attacking frame (towards x=105). cells is row-major, rows from y=0, values sum to 1.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cols",
        "rows",
        "cells"
      ],
      "properties": {
        "cols": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "PlayerLine": {
      "description": "Compact live line per player for the match screen and player tags.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_id",
        "team_id",
        "on_pitch",
        "touches",
        "passes",
        "passes_completed",
        "shots",
        "goals",
        "xg",
        "distance_km",
        "top_speed_kmh",
        "speed_kmh"
      ],
      "properties": {
        "player_id": {
          "type": "string"
        },
        "team_id": {
          "type": "string"
        },
        "on_pitch": {
          "type": "boolean"
        },
        "touches": {
          "type": "integer",
          "minimum": 0
        },
        "passes": {
          "type": "integer",
          "minimum": 0
        },
        "passes_completed": {
          "type": "integer",
          "minimum": 0
        },
        "shots": {
          "type": "integer",
          "minimum": 0
        },
        "goals": {
          "type": "integer",
          "minimum": 0
        },
        "xg": {
          "type": "number",
          "minimum": 0
        },
        "distance_km": {
          "type": "number",
          "minimum": 0
        },
        "top_speed_kmh": {
          "type": [
            "number",
            "null"
          ]
        },
        "speed_kmh": {
          "description": "Current speed, smoothed over 0.6 s.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "TeamLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_id",
        "name",
        "short_name",
        "score",
        "red_cards",
        "color"
      ],
      "properties": {
        "team_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "short_name": {
          "type": "string"
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "red_cards": {
          "type": "integer",
          "minimum": 0
        },
        "color": {
          "type": "string"
        }
      }
    },
    "GoalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "team_id",
        "player_id",
