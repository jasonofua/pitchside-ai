    "MomentumNow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "swing",
        "dominant_team_id"
      ],
      "properties": {
        "index": {
          "description": "Control vs Chaos index over the last 5 minutes: +100 = full control, -100 = full chaos.",
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "swing": {
          "description": "Change in the index over the last 5 minutes.",
          "type": "number"
        },
        "dominant_team_id": {
          "description": "Team with more than 55% of ball-in-play possession in the window; null when the split is closer.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "MomentumComponents": {
      "description": "Each component in [-1, 1]; positive pulls towards control.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stability",
        "turnovers",
        "pressure",
        "tempo"
      ],
      "properties": {
        "stability": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "turnovers": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "pressure": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "tempo": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "MomentumPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "clock_ms",
        "minute",
        "index",
        "home_share",
        "components"
      ],
      "properties": {
        "period": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "clock_ms": {
          "type": "integer"
        },
        "minute": {
          "$ref": "#/$defs/Minute"
        },
        "index": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "home_share": {
          "description": "Home share of ball-in-play possession in the 5-minute window, 0-1.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "components": {
          "$ref": "#/$defs/MomentumComponents"
        }
      }
    },
    "Momentum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_id",
        "window",
        "now",
