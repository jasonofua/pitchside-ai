          "description": "Completed passes between two players (either direction), at least 3.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NetworkEdge"
          }
        }
      }
    },
    "DifficultyHistogram": {
      "description": "Pass counts per 10-point difficulty bin (0-10, 10-20, ... 90-100).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_id",
        "completed",
        "incomplete"
      ],
      "properties": {
        "team_id": {
          "type": "string"
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 10,
          "maxItems": 10
        },
        "incomplete": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 10,
          "maxItems": 10
        }
      }
    },
    "AnalystReport": {
      "description": "Everything the Analyst dashboard draws, computed by the Stats Engine.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_id",
        "minute",
        "shots",
        "networks",
        "histograms",
        "momentum"
      ],
      "properties": {
        "match_id": {
          "type": "string"
        },
        "minute": {
          "$ref": "#/$defs/Minute"
        },
        "shots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShotMapItem"
          }
        },
        "networks": {
          "description": "Home first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PassNetwork"
          }
        },
        "histograms": {
          "description": "Home first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DifficultyHistogram"
          }
        },
        "momentum": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MomentumPoint"
          }
        }
      }
    }
  }
}
