# Copy to .env for local runs. Never commit real values.
# In Azure, `azd up` sets these on the Container Apps; auth is managed identity, no keys.

# --- Models --------------------------------------------------------------------------
# Leave all of these unset to run the offline mock models (no account needed).

# Microsoft Foundry: project endpoint and the two model deployments. Locally the
# credential comes from `az login` (DefaultAzureCredential).
# FOUNDRY_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project>
# MODEL_LARGE=gpt-5.4
# MODEL_SMALL=gpt-5.4-mini
# Reasoning effort for gpt-5.x / o-series models: none | low | medium | high (default low).
# PITCHSIDE_REASONING_EFFORT=low

# Or any OpenAI-compatible endpoint (Ollama, LM Studio, a proxy, ...). MODEL_LARGE and
# MODEL_SMALL name its models.
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=

# Force a choice: foundry | openai | mock (default: whichever is configured above).
# PITCHSIDE_LLM=mock

# Seconds before an agent's stats-only card goes out while the model keeps working.
# PITCHSIDE_MODEL_TIMEOUT_S=4

# --- Runtime -------------------------------------------------------------------------
# local (in-process bus, SQLite) or azure (Event Hubs, Cosmos DB, Web PubSub).
# PITCHSIDE_MODE=local
# all | gateway | sim | ingestor | stats | agents
# PITCHSIDE_ROLE=all
# PITCHSIDE_DATA_DIR=data/runtime
# PITCHSIDE_MCP_URL=http://127.0.0.1:8000/mcp
# PITCHSIDE_ALLOWED_ORIGINS=*
# PITCHSIDE_START_COOLDOWN_S=20
# PITCHSIDE_LOG_LEVEL=INFO

# Optional: use a different world file.
# PITCHSIDE_WORLD=data/world.json
