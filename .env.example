# Copy to .env for local runs. Never commit real values.
# In Azure these come from managed identity and Key Vault instead.

# Microsoft Foundry project endpoint and model deployment names (from Day 3).
FOUNDRY_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project>
MODEL_LARGE=<large-chat-deployment-name>
MODEL_SMALL=<small-fast-deployment-name>

# Local mode: point at any OpenAI-compatible endpoint, or leave unset to use the mock.
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=

# Optional: use a different world file.
# PITCHSIDE_WORLD=data/world.json
